# ============================================================
# LedgerLens-data .gitignore
# ============================================================

# Python bytecode / caches
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Test caches and artefacts
.pytest_cache/
.hypothesis/
*.snap               # test snapshots (e.g. syrupy)
tests/__snapshots__/
tests/**/*.snap
*/__snapshots__/
**/snapshots/
*.ambr
junit*.xml
test-results/
test_output/
# Fuzz corpus (generated at runtime — keep only hand-crafted seeds in VCS)
tests/fuzz/corpus/generated/

# Virtual environments
.venv/
venv/
env/
.env/
ENV/

# Environment / secrets
.env
.env.*
!.env.example
.env.local
.env.*.local
*.secret
*.secrets

# Databases (SQLite, DuckDB, etc.)
*.db
*.sqlite
*.sqlite3
*.duckdb

# Model artefacts — binaries and training outputs (keep README and schema files)
models/*.pkl
models/*.joblib
models/*.pt
models/*.onnx
models/archive/
models/optuna_studies.db
models/best_params_*.json
models/pareto_front.json
models/shap_cache_*.joblib
models/shap_sensitivity.json
models/conformal_calibration.joblib

# Benchmark output reports (generated; not source)
reports/
# Keep committed sample/reference reports
!reports/adversarial_benchmark.json
!reports/load_test_sample.json

# Benchmark runner outputs (issue #537)
benchmarks/outputs/
benchmarks/*.benchmark.json
benchmarks/*.report.json

# CI metrics history — the JSONL store is ephemeral in CI; commit only if
# you want to track history in the repo (not recommended for large stores)
ci_metrics/history.jsonl

# Static analysis gate outputs (issue #545)
.mypy_cache/
.ruff_cache/
.bandit/
.radon_cache/
.cache/
bandit_report.json
mypy_report.xml

# Type-checker caches
.dmypy.json
dmypy.json
.pytype/
.pyre/

# Triage reports (generated by scripts/triage_build_failures.py — Issue #539)
reports/triage/
reports/ci/
junit_results.xml
reports/ci/junit_results.xml

# Threshold tuning reports (generated by scripts/tune_alert_thresholds.py — Issue #535)
reports/threshold_tuning/

# Feature compat reports (generated by scripts/check_feature_compat.py — Issue #532)
reports/feature_compat/

# Scenario regression reports (generated by scripts/replay_scenario.py — Issue #536)
reports/scenario_regression.json
data/scenarios/

# Backtest and replay cache
data/backtest_cache/
data/replay_cache/

# mutmut mutation testing cache
.mutmut-cache
mutmut-results.json
mutmut-results/
html/
mutmut-results.xml

# Jupyter notebook execution artefacts
notebooks/.ipynb_checkpoints/
notebooks/**/.ipynb_checkpoints/
.ipynb_checkpoints/
*.nbconvert.ipynb
# Notebook validation artefacts (issue #549)
notebooks/validation_report_*.json

# Coverage reports
.coverage
.coverage.*
htmlcov/
coverage.xml
coverage.json

# Distribution / build artefacts
dist/
build/
*.egg-info/
*.egg
.eggs/
*.whl
MANIFEST

# Byte-compiled Cython
*.c
*.so

# Editor / OS artefacts
.DS_Store
.DS_Storename
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/
.vscode/settings.json
*.code-workspace
.project
.classpath

# Profiling
*.prof
*.lprof
*.pyc.profiler
profiling/

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp
*.temp
*.bak
*.orig
*.parquet.tmp

# Docker build context leftover
.dockerignore.bak
*.tar.gz

# Optuna hyperparameter search DB (generated at runtime)
optuna_*.db
optuna_studies/

# Adversarial eval outputs
reports/forensic/
reports/poisoning_alert_*.json
reports/backtest_*.json
reports/retrain_report_*.json
reports/load_test_results.json

# Data pipeline generated files (not source data)
data/*.parquet
data/*.csv
data/annotation_queue.json
data/annotation_queue.json.bak
data/unscored_wallets.parquet
data/annotated.parquet
data/watermarks.json
# Keep committed static data files
!data/synthetic_dataset.parquet
!data/known_manipulation_events.csv
!data/feature_ranges.json
!data/trade_avro_schema.json
!data/allowlist.json
!data/denylist.json
!data/bridge_anchors.json
!data/zero_shot_patterns.json
!data/causal_priors.yaml
!data/build_config.json

# Redis dump files (if running local Redis)
dump.rdb

# Node.js (markdown-link-check installed via npm)
node_modules/
package-lock.json

# Issue #527 — partitioned dataset output
data/partitioned/
data/intermediate/

# Issue #530 — retention audit logs (generated at runtime)
reports/retention_audit*.ndjson

# Issue #533 — dataset reproducibility snapshots
data/snapshots/

# Issue #534 — run comparison reports (generated at runtime)
reports/run_comparison*.json
reports/drift_report_*.json

# Import cycle detection artefacts (generated; not committed) — Issue #546
import_cycle_report_*.json

# Dependency probe reports (generated; not committed) — Issue #542
dependency_probe_report_*.json

# Secrets / keys (belt-and-suspenders — should never be committed)
*.pem
*.key
*.p12
*.pfx
jwt_public_key.pem
jwt_private_key.pem
models/metrics.json.sig

# Dead-letter queue files (runtime output)
alerts_dlq.ndjson

# Grafana provisioning secrets
monitoring/grafana/provisioning/datasources/*.yaml

# -----------------------------------------------------------------------
# Issues #960-#963 — CLI dry-run, audit logging, confirmation, migration testing
# -----------------------------------------------------------------------

# CLI audit log (runtime output, not source)
logs/cli_audit.ndjson
logs/

# Migration snapshot test artefacts (generated; not committed)
data/migration_snapshots/
tests/snapshots/
migration_test_snapshot_*.db

# Backup/restore runtime outputs (timestamped; never committed)
backups/
