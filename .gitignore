# Redis dump files (if running local Redis)
dump.rdb

# Node.js (markdown-link-check installed via npm)
node_modules/
package-lock.json

# Issue #527 — partitioned dataset output
data/partitioned/
data/intermediate/

# Issue #530 — retention audit logs (generated at runtime)
reports/retention_audit*.ndjson

# Issue #533 — dataset reproducibility snapshots
data/snapshots/

# Issue #534 — run comparison reports (generated at runtime)
reports/run_comparison*.json
reports/drift_report_*.json

# Import cycle detection artefacts (generated; not committed) — Issue #546
import_cycle_report_*.json

# Dependency probe reports (generated; not committed) — Issue #542
dependency_probe_report_*.json

# Secrets / keys (belt-and-suspenders — should never be committed)
*.pem
*.key
*.p12
*.pfx
jwt_public_key.pem
jwt_private_key.pem
models/metrics.json.sig
# Issue #943 — Ed25519 signing keys for audit summaries (never commit private keys)
audit_signing*.pem
audit_verify*.pem
*_priv.pem
*_signing_key.pem

# Dead-letter queue files (runtime output)
alerts_dlq.ndjson

# Issue #940 — automated rollback trigger audit logs (runtime-generated JSONL)
reports/rollback_audit.jsonl
reports/rollback_audit*.jsonl

# Issue #941 — experiment tracking JSONL store (runtime-generated; use DVC/artifact store for
# long-term experiment history; the in-repo file is only for local dev/smoke tests)
models/experiments.jsonl
# Issue #963 — Migration snapshot test artefacts (generated at runtime)
tests/migration_snapshots/
data/migration_test_snapshots/
migration_snapshot_*.db
migration_snapshot_*.sqlite

# Issue #961 — CLI audit trail (runtime-generated; not committed)
data/audit_trail.ndjson
data/cli_audit_trail.ndjson

# Grafana provisioning secrets
monitoring/grafana/provisioning/datasources/*.yaml
branch_structure.json

# Issue #952-955 additions -----------------------------------------------

# Additional snapshot patterns (belt-and-suspenders)
__snapshots__/
**/__pycache__/
*.pyc

# Tox virtualenv artefacts
.tox/

# Benchmark raw outputs (keep .md reports; exclude generated data files)
benchmarks/*.json
benchmarks/*.csv

# Model binary artefacts (any location, not just models/)
*.joblib
*.pkl
*.h5

# Data files at repo root (not just data/ subdir)
!data/dataset_card.md

# reports/ keep-marker
!reports/.gitkeep
