# Which of these vars are actually required depends on which entry point
# you're running (the REST API, the streaming pipeline, on-chain submission,
# training, ...). See config/contracts.py for the per-runtime-mode contract,
# and run `make check-env MODE=<mode>` to check your .env against one before
# starting the service.

# Stellar Horizon API endpoint used for ingestion.
# Default: https://horizon.stellar.org
# Optional.
HORIZON_URL=https://horizon.stellar.org

# Network passphrase used when submitting Soroban transactions.
# Options: PUBLIC, TESTNET
# Default: PUBLIC
# Optional.
STELLAR_NETWORK=PUBLIC

# Assets/pairs to monitor, comma-separated CODE:ISSUER pairs (use "native" as the
# issuer for XLM).
# Default: a single sample USDC:issuer pair (see config.py).
# Required.
WATCHED_ASSET_PAIRS=USDC:GA5Z...,XLM:native

# AMM liquidity pool IDs to monitor, comma-separated 64-char lowercase hex strings.
# Each ID must be a valid Stellar liquidity pool ID (64 lowercase hex chars).
# Example: WATCHED_AMM_POOLS=abcd1234...(64 chars),ef012345...(64 chars)
# Default: empty (no pools monitored).
# Optional.
WATCHED_AMM_POOLS=

# Rolling window sizes (hours) used by the Benford engine, comma-separated integers.
# Default: 1,4,24,168,720
# Optional.
BENFORD_WINDOWS_HOURS=1,4,24,168,720

# Time window (seconds) used when comparing transactions across asset pairs for
# cross-pair synchrony detection.
# Default: 30
# Optional.
CROSS_PAIR_SYNCHRONY_WINDOW_SECONDS=30

# Minimum number of trades required before a wallet is scored.
# Default: 20
# Optional.
MIN_TRADES_FOR_SCORING=20

# Risk score (0-100) at or above which a wallet is flagged.
# Default: 70
# Optional.
RISK_SCORE_FLAG_THRESHOLD=70

# SQLAlchemy connection URL for storing computed risk scores.
# Default: sqlite:///ledgerlens.db
# Optional.
RISK_SCORE_DB_URL=sqlite:///ledgerlens.db

# Database connection pooling settings (SQLAlchemy engine options).
# Defaults: DB_POOL_SIZE=5, DB_MAX_OVERFLOW=10, DB_POOL_TIMEOUT=30 (seconds)
# Optional.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Directory where trained model artifacts are read from/written to.
# Default: ./models
# Optional.
MODEL_DIR=./models

# ledgerlens-score Soroban contract integration (integrations/contract_client.py).
# Soroban RPC endpoint used to submit forensic reports on-chain.
# Default: https://soroban-testnet.stellar.org
# Optional.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Deployed contract ID of the ledgerlens-score Soroban contract.
# Default: empty.
# Required only when submitting reports on-chain (require_onchain=True).
LEDGERLENS_CONTRACT_ID=
# Stellar secret key (starts with "S") used to sign and submit contract transactions.
# Default: empty.
# Required only when submitting reports on-chain (require_onchain=True).
# WARNING: Never commit this value to version control.
LEDGERLENS_SUBMITTER_SECRET=

# Real-time streaming / alerting (scripts/stream.py)
# Ingestion transport: "sse" (default, thread-per-pair Horizon SSE) or "kafka".
# Default: sse
# Optional.
STREAMING_BACKEND=sse

# ---------------------------------------------------------------------------
# Kafka streaming backend (only used when STREAMING_BACKEND=kafka)
# ---------------------------------------------------------------------------
# Comma-separated host:port list of Kafka brokers.
# Default: localhost:9092
# Required when STREAMING_BACKEND=kafka.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# SASL credentials are read from these env vars ONLY — never commit real values.
# Default: empty (SASL auth disabled).
# Optional; required only if the Kafka cluster enforces SASL auth.
# WARNING: Never commit real credentials to version control.
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
# Consumer lag (messages behind the high watermark) that triggers a CRITICAL log.
# Default: 500
# Optional.
KAFKA_LAG_ALERT_THRESHOLD=500
# Kafka consumer group ID for the trade-scoring workers.
# Default: ledgerlens-scorer
# Optional.
KAFKA_CONSUMER_GROUP=ledgerlens-scorer
# Port the Kafka consumer exposes Prometheus metrics on.
# Default: 9100
# Optional.
KAFKA_METRICS_PORT=9100

# ---------------------------------------------------------------------------
# Example: complete streaming_kafka runtime-mode config (local dev)
# ---------------------------------------------------------------------------
# Uncomment this block to run `python -m scripts.stream --backend kafka`
# against a local Kafka cluster (e.g. `docker-compose up kafka zookeeper`).
# `make check-env MODE=streaming_kafka` validates this exact set of
# variables against config/contracts.py's streaming_kafka contract.
#
# STREAMING_BACKEND=kafka
# WATCHED_ASSET_PAIRS=USDC:GA5ZSEJYBY3RJRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN,XLM:native
# MODEL_DIR=./models
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# TRADE_AVRO_SCHEMA_PATH=data/trade_avro_schema.json
# ALERT_CHANNEL=stdout
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# Alert delivery channel used by scripts/stream.py.
# Options: stdout, webhook, websocket
# Default: stdout
# Optional.
ALERT_CHANNEL=stdout
# HTTPS endpoint to POST alerts to.
# Default: empty.
# Required when ALERT_CHANNEL=webhook.
ALERT_WEBHOOK_URL=
# Minimum seconds between repeat alerts for the same wallet/rule.
# Default: 3600
# Optional.
ALERT_COOLDOWN_SECONDS=3600
# NDJSON file that alerts are appended to when delivery fails.
# Default: alerts_dlq.ndjson
# Optional.
ALERT_DEAD_LETTER_PATH=alerts_dlq.ndjson
# TCP port the WebSocket alert server listens on.
# Default: 8765
# Optional.
WS_PORT=8765
# Network interface the WebSocket server binds to.
# Default: 127.0.0.1 (loopback only)
# Optional.
WS_BIND_HOST=127.0.0.1
# Set WS_ALLOW_EXTERNAL=1 to bind the WebSocket server to 0.0.0.0 (non-loopback).
# Default: empty (disabled — loopback only).
# Optional.
WS_ALLOW_EXTERNAL=

# WebSocket pub/sub server authentication and limits (streaming/ws_server.py)
# Path to the PEM-encoded public key used to verify client JWTs.
# Default: ./jwt_public_key.pem
# Optional.
JWT_PUBLIC_KEY_PATH=./jwt_public_key.pem
# Maximum number of concurrent WebSocket clients.
# Default: 200
# Optional.
WS_MAX_CLIENTS=200
# Maximum number of buffered outbound messages per client before it is disconnected.
# Default: 100
# Optional.
WS_CLIENT_QUEUE_DEPTH=100
# Number of recent messages kept for replay to newly-connected clients.
# Default: 1000
# Optional.
WS_REPLAY_BUFFER_SIZE=1000
# Maximum inbound messages accepted per client per second.
# Default: 100
# Optional.
WS_RATE_LIMIT_MSGS_PER_SECOND=100

# ---------------------------------------------------------------------------
# Model integrity — DO NOT COMMIT THESE VALUES
# ---------------------------------------------------------------------------

# Path to the Ed25519 PEM private key used to sign metrics.json after training.
# Generate with: openssl genpkey -algorithm ed25519 -out signing_key.pem
# Default: empty.
# Required for model signing; otherwise optional.
# WARNING: Never commit this file or its contents to version control.
MODEL_SIGNING_PRIVATE_KEY_PATH=

# SHA-256 fingerprint of the trusted Ed25519 public key (hex).
# Used by verify_chain() to confirm the artifact was signed by the expected key.
# Default: empty.
# Required for signature verification; otherwise optional.
TRUSTED_SIGNING_KEY_FINGERPRINT=

# Append-only NDJSON log of signed forensic report commitments.
# Default: data/audit_trail.ndjson
# Optional.
AUDIT_LOG_PATH=data/audit_trail.ndjson

# Optional Ed25519 public key PEM for verify_audit_trail.py (defaults to private-key pair).
# Default: empty.
# Optional.
AUDIT_VERIFY_PUBLIC_KEY_PATH=

# BFT voting thresholds (defaults shown).
# BFT_SCORE_DIVERGENCE_THRESHOLD: max allowed score divergence between voters.
# BFT_MIN_CONSENSUS: minimum number of voters that must agree.
# Defaults: BFT_SCORE_DIVERGENCE_THRESHOLD=30, BFT_MIN_CONSENSUS=2
# Optional.
BFT_SCORE_DIVERGENCE_THRESHOLD=30
BFT_MIN_CONSENSUS=2

# Maximum allowed shift in wash-trade label ratio before training is aborted
# (data-poisoning guard).
# Default: 0.15
# Optional.
POISON_LABEL_RATIO_THRESHOLD=0.15

# HMAC secret for annotation queue integrity.
# Default: empty.
# Required for annotation queue signing; otherwise optional.
# WARNING: Never commit this value to version control.
ANNOTATION_HMAC_SECRET=

# ---------------------------------------------------------------------------
# Adversarial training (disabled by default)
# ---------------------------------------------------------------------------

# Ratio of adversarially-perturbed copies added per clean training sample when
# --adversarial-augmentation is passed to detection/model_training.py.
# 0.0 = disabled (default).  Typical useful range: 0.25-1.0.
# Optional.
ADVERSARIAL_AUG_RATIO=0.0

# ---------------------------------------------------------------------------
# Differentially private neural training (DP-SGD / Opacus)
# ---------------------------------------------------------------------------

# Target privacy budget (epsilon) for DANN encoder and meta-learner training.
# Default: 8.0
# Optional.
DP_TARGET_EPSILON=8.0
# Target privacy budget (delta) for DANN encoder and meta-learner training.
# Default: 1e-5
# Optional.
DP_TARGET_DELTA=1e-5
# Maximum L2 norm gradients are clipped to before noise is added (DP-SGD).
# Default: 1.0
# Optional.
DP_MAX_GRAD_NORM=1.0
# Number of training epochs for DP-SGD runs.
# Default: 50
# Optional.
DP_EPOCHS=50

# ---------------------------------------------------------------------------
# Active learning
# ---------------------------------------------------------------------------

# Query strategy for selecting wallets to annotate.
# Options: least_confidence, margin, entropy, coreset, badge, committee_disagreement
# Default: committee_disagreement
# Optional.
AL_QUERY_STRATEGY=committee_disagreement

# Number of wallets to select per active learning run.
# Default: 20
# Optional.
AL_BATCH_SIZE=20

# Minimum new labelled samples to trigger a full retrain (vs warm-start).
# Default: 50
# Optional.
AL_RETRAIN_THRESHOLD=50

# Maximum allowed AUC-ROC drop before rolling back a model update.
# Default: 0.01
# Optional.
AL_ROLLBACK_AUC_DROP=0.01

# Path to the annotation queue JSON file.
# Default: data/annotation_queue.json
# Optional.
AL_QUEUE_PATH=data/annotation_queue.json

# ---------------------------------------------------------------------------
# Transformer sequence model (#182)
# ---------------------------------------------------------------------------

# Number of distinct asset-pair slots in the one-hot pair encoding.
# Increase if monitoring more than 32 distinct trading pairs.
# Default: 32
# Optional.
SEQ_MODEL_NUM_PAIRS=32

# Dimension of the token embeddings and the sequence-level output embedding.
# This adds SEQ_MODEL_EMBED_DIM new columns (seq_0 … seq_N) to the feature vector.
# Default: 64
# Optional.
SEQ_MODEL_EMBED_DIM=64

# Number of self-attention heads. Must divide SEQ_MODEL_EMBED_DIM evenly.
# Default: 4
# Optional.
SEQ_MODEL_NUM_HEADS=4

# Number of transformer encoder layers (2–4 recommended for < 50 ms CPU latency).
# Default: 2
# Optional.
SEQ_MODEL_NUM_LAYERS=2

# Feed-forward expansion dimension inside each transformer layer.
# Default: 128
# Optional.
SEQ_MODEL_FFN_DIM=128

# Dropout rate applied during training (disabled at eval time).
# Default: 0.1
# Optional.
SEQ_MODEL_DROPOUT=0.1

# Maximum allowed input sequence length.
# Inputs longer than this are rejected before reaching the model (prevents memory exhaustion).
# Default: 512
# Optional.
SEQ_MODEL_MAX_LENGTH=512

# Whether to load the sequence model at inference time.
# Set to "false" before running the first training run (no artifact exists yet).
# Default: true
# Optional.
SEQ_MODEL_ENABLED=true

# ---------------------------------------------------------------------------
# Redis feature store (#183)
# ---------------------------------------------------------------------------

# Redis connection URL for the streaming feature store.
# Use rediss:// for TLS-encrypted connections.
# Defaults to REDIS_URL database 1 (separate from the rate-limiter on db 0).
# Default: redis://localhost:6379/1
# Optional.
FEATURE_STORE_REDIS_URL=redis://localhost:6379/1

# Enable TLS for the feature store Redis connection.
# Also implied when FEATURE_STORE_REDIS_URL starts with rediss://.
# Default: false
# Optional.
FEATURE_STORE_REDIS_TLS=false

# Path to the CA certificate file for TLS verification.
# Leave empty to skip CA verification (not recommended in production).
# Default: empty
# Optional.
FEATURE_STORE_REDIS_TLS_CA_CERT=

# Maximum number of connections in the Redis connection pool.
# Default: 10
# Optional.
FEATURE_STORE_REDIS_POOL_SIZE=10

# Per-window TTLs for cached feature vectors.
# Format: comma-separated "hours:seconds" pairs.
# Default: 1:3600,4:14400,24:86400,168:604800,720:2592000
# Optional.
FEATURE_STORE_WINDOW_TTLS=1:3600,4:14400,24:86400,168:604800,720:2592000

# Fall back to direct feature computation when Redis is unavailable.
# Set to false to surface Redis errors directly (useful for debugging).
# Default: true
# Optional.
FEATURE_STORE_FALLBACK_ENABLED=true

# In-memory feature cache TTL (seconds) for the streaming scorer.
# Default: 30
# Optional.
FEATURE_CACHE_TTL_SECONDS=30

# Maximum number of entries in the in-memory feature cache.
# Default: 1000
# Optional.
FEATURE_CACHE_MAXSIZE=1000

# ---------------------------------------------------------------------------
# Logging and observability
# ---------------------------------------------------------------------------

# Log format: "json" or "plain".
# Default: json
# Optional.
LOG_FORMAT=json

# ---------------------------------------------------------------------------
# Horizon ingestion tuning
# ---------------------------------------------------------------------------

# Maximum requests per second to the Horizon REST API.
# Default: 80
# Optional.
HORIZON_MAX_RPS=80

# Maximum retries for failed Horizon requests.
# Default: 5
# Optional.
HORIZON_MAX_RETRIES=5

# Failover Horizon endpoints (comma-separated).
# Default: empty
# Optional.
HORIZON_FAILOVER_URLS=

# Enable Horizon developer mode (more verbose logging).
# Default: empty (disabled)
# Optional.
HORIZON_DEV_MODE=

# Seconds to wait for Horizon failover endpoint response.
# Default: 5.0
# Optional.
HORIZON_FAILOVER_TIMEOUT_SECONDS=5.0

# Seconds between Horizon health-check pings.
# Default: 30.0
# Optional.
HORIZON_HEALTH_CHECK_INTERVAL_SECONDS=30.0

# Interval (seconds) to reload the watched asset pair list from disk.
# Default: 60
# Optional.
LIST_RELOAD_INTERVAL_SECONDS=60

# Solana RPC endpoint for cross-chain resolution.
# Default: https://api.mainnet-beta.solana.com
# Optional.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ---------------------------------------------------------------------------
# Feature engineering / Benford drift detection
# ---------------------------------------------------------------------------

# Minimum sample size for a Benford window to be statistically valid.
# Default: 50
# Optional.
BENFORD_MIN_SAMPLE_SIZE=50

# Enable Benford drift detection to trigger retraining.
# Default: true
# Optional.
BENFORD_DRIFT_DETECTION_ENABLED=true

# Z-score threshold for flagging a shift in chi-square or MAD per-pair.
# Default: 3.0
# Optional.
BENFORD_DRIFT_Z_THRESHOLD=3.0

# Minimum pairs that must drift before firing a global retraining trigger.
# Default: 0
# Optional.
BENFORD_DRIFT_NUM_PAIRS_TRIGGER=0

# Enable Benford CI bootstrapping.
# Default: false
# Optional.
BENFORD_CI_ENABLED=false

# ---------------------------------------------------------------------------
# Conformal prediction
# ---------------------------------------------------------------------------

# Coverage level for conformal prediction intervals (e.g. 0.90 = 90%).
# Default: 0.90
# Optional.
CONFORMAL_COVERAGE_LEVEL=0.90

# Enable conformal prediction intervals in the API response.
# Default: true
# Optional.
CONFORMAL_ENABLED=true

# ---------------------------------------------------------------------------
# Wallet graph / ring detection
# ---------------------------------------------------------------------------

# Maximum traversal depth for multi-hop funding graph analysis.
# Default: 4
# Optional.
WALLET_GRAPH_MAX_DEPTH=4

# Minimum ring size for Louvain community detection.
# Default: 3
# Optional.
WASH_RING_MIN_SIZE=3

# Louvain resolution parameter for community detection.
# Default: 1.0
# Optional.
WASH_RING_RESOLUTION=1.0

# Fixed seed for deterministic Louvain community detection.
# Default: 42
# Optional.
WASH_RING_LOUVAIN_SEED=42

# Timeout (seconds) for motif census computation.
# Default: 5
# Optional.
MOTIF_CENSUS_TIMEOUT_SECONDS=5

# ---------------------------------------------------------------------------
# Model integrity, BFT voting, and differential privacy
# ---------------------------------------------------------------------------

# Ed25519 private key path for signing metrics.json after training.
# Default: empty
# Optional.
MODEL_SIGNING_PRIVATE_KEY_PATH=

# SHA-256 fingerprint of the trusted Ed25519 public key.
# Default: empty
# Optional.
TRUSTED_SIGNING_KEY_FINGERPRINT=

# BFT score divergence threshold (max allowed divergence between voters).
# Default: 30
# Optional.
BFT_SCORE_DIVERGENCE_THRESHOLD=30

# Minimum number of voters that must agree in BFT trimmed-mean.
# Default: 2
# Optional.
BFT_MIN_CONSENSUS=2

# Maximum allowed shift in wash-trade label ratio before aborting training.
# Default: 0.15
# Optional.
POISON_LABEL_RATIO_THRESHOLD=0.15

# Differential privacy aggregation epsilon (training statistics).
# Default: 1.0
# Optional.
DP_AGGREGATOR_EPSILON=1.0

# Differential privacy aggregation delta.
# Default: 1e-5
# Optional.
DP_AGGREGATOR_DELTA=1e-5

# DP budget total epsilon cap across all training rounds and inference queries.
# Default: 100.0
# Optional.
DP_BUDGET_TOTAL_EPSILON=100.0

# Alert threshold for remaining DP epsilon budget.
# Default: 10.0
# Optional.
DP_BUDGET_ALERT_THRESHOLD=10.0

# Default SHAP sensitivity fallback when feature is absent from shap_sensitivity.json.
# Default: 0.05
# Optional.
DP_DEFAULT_SENSITIVITY=0.05

# Model inversion query limit per wallet.
# Default: 100
# Optional.
MODEL_INVERSION_QUERY_LIMIT=100

# DP epsilon for model inversion defence.
# Default: 1.0
# Optional.
MODEL_INVERSION_DP_EPSILON=1.0

# Granularity for rounding risk scores (prevents fingerprinting).
# Default: 1
# Optional.
SCORE_ROUNDING_GRANULARITY=1

# Zero-shot classification weight in the ensemble.
# Default: 0.0
# Optional.
ZERO_SHOT_WEIGHT=0.0

# Minimum labelled examples required for zero-shot mode.
# Default: 20
# Optional.
ZERO_SHOT_MIN_LABELLED_EXAMPLES=20

# ---------------------------------------------------------------------------
# Adversarial training
# ---------------------------------------------------------------------------

# Enable FGSM adversarial training loop.
# Default: false
# Optional.
ADV_TRAINING_ENABLED=false

# Number of adversarial training epochs.
# Default: 3
# Optional.
ADV_TRAINING_EPOCHS=3

# FGSM epsilon perturbation magnitude.
# Default: 0.1
# Optional.
ADV_TRAINING_EPSILON=0.1

# Ratio of adversarial examples per clean sample.
# Default: 0.5
# Optional.
ADV_TRAINING_RATIO=0.5

# Ratio of adversarially-perturbed copies added per clean training sample.
# Default: 0.0
# Optional.
ADVERSARIAL_AUG_RATIO=0.0

# ---------------------------------------------------------------------------
# Active learning
# ---------------------------------------------------------------------------

# Aleatoric uncertainty threshold above which a sample is treated as label noise.
# Default: 0.7
# Optional.
ACTIVE_LEARNING_ALEATORIC_THRESHOLD=0.7

# Monte Carlo Dropout forward passes for epistemic uncertainty.
# Default: 20
# Optional.
ACTIVE_LEARNING_MC_DROPOUT_PASSES=20

# Active learning exploration vs exploitation weight.
# Default: 0.5
# Optional.
ACTIVE_LEARNING_ALPHA=0.5

# Core-set minimum distance threshold.
# Default: 0.1
# Optional.
CORESET_MIN_DISTANCE=0.1

# Active learning EER (equal error rate) stopping threshold.
# Default: 0.001
# Optional.
ACTIVE_LEARNING_EER_THRESHOLD=0.001

# Convergence window for active learning stopping criterion.
# Default: 5
# Optional.
ACTIVE_LEARNING_CONVERGENCE_WINDOW=5

# ---------------------------------------------------------------------------
# Wash trade simulation
# ---------------------------------------------------------------------------

# Number of GAN training rounds.
# Default: 5
# Optional.
GAN_ROUNDS=5

# GAN plateau threshold for early stopping.
# Default: 0.005
# Optional.
GAN_PLATEAU_THRESHOLD=0.005

# Number of wallets in the simulator.
# Default: 50
# Optional.
SIMULATOR_N_WALLETS=50

# Number of trades per wallet in the simulator.
# Default: 100
# Optional.
SIMULATOR_TRADES_PER_WALLET=100

# ---------------------------------------------------------------------------
# GNN encoder
# ---------------------------------------------------------------------------

# GNN embedding dimension.
# Default: 32
# Optional.
GNN_EMBEDDING_DIM=32

# GNN hidden layer dimension.
# Default: 64
# Optional.
GNN_HIDDEN_DIM=64

# Number of GNN layers.
# Default: 2
# Optional.
GNN_NUM_LAYERS=2

# GNN DiffPool number of clusters.
# Default: 10
# Optional.
GNN_DIFFPOOL_CLUSTERS=10

# ---------------------------------------------------------------------------
# Ensemble dynamic weights and shadow deployment
# ---------------------------------------------------------------------------

# Smoothing alpha for ensemble weight updates.
# Default: 0.1
# Optional.
ENSEMBLE_WEIGHT_SMOOTHING_ALPHA=0.1

# Systemic false-positive threshold for ensemble weight adjustment.
# Default: 0.5
# Optional.
ENSEMBLE_SYSTEMIC_FP_THRESHOLD=0.5

# Percentage of shadow traffic for model comparison.
# Default: 20
# Optional.
SHADOW_TRAFFIC_PERCENT=20

# Shadow comparison period in hours.
# Default: 24
# Optional.
SHADOW_PERIOD_HOURS=24

# Drift threshold points for shadow promotion.
# Default: 15
# Optional.
SHADOW_DRIFT_THRESHOLD_POINTS=15

# Maximum allowed drift rate for shadow promotion.
# Default: 0.05
# Optional.
SHADOW_DRIFT_MAX_RATE=0.05

# Maximum allowed false-positive rate excess for shadow promotion.
# Default: 0.10
# Optional.
SHADOW_FP_RATE_MAX_EXCESS=0.10

# ---------------------------------------------------------------------------
# Federated learning
# ---------------------------------------------------------------------------

# Number of async updates to trigger federated aggregation.
# Default: 3
# Optional.
FEDERATED_ASYNC_TRIGGER_N=3

# Seconds between federated aggregation triggers.
# Default: 300
# Optional.
FEDERATED_ASYNC_TRIGGER_SECONDS=300

# Maximum staleness (in rounds) for federated updates.
# Default: 5
# Optional.
FEDERATED_MAX_STALENESS=5

# ---------------------------------------------------------------------------
# Graph cache and feature cache tuning
# ---------------------------------------------------------------------------

# Maximum age (hours) for cached graph edges before refresh.
# Default: 168
# Optional.
GRAPH_STALE_EDGE_MAX_AGE_HOURS=168

# ---------------------------------------------------------------------------
# Label quality estimation
# ---------------------------------------------------------------------------

# Noise threshold for label quality estimation.
# Default: 0.1
# Optional.
LABEL_QUALITY_NOISE_THRESHOLD=0.1

# Annotator noise rate alert threshold.
# Default: 0.2
# Optional.
ANNOTATOR_NOISE_RATE_ALERT_THRESHOLD=0.2

# ---------------------------------------------------------------------------
# Model input validation
# ---------------------------------------------------------------------------

# Strictness level for model input validation: raise, warn, coerce, ignore.
# Default: warn
# Optional.
MODEL_INPUT_VALIDATOR_STRICTNESS=warn

# Path to feature_ranges.json for input validation bounds.
# Default: data/feature_ranges.json
# Optional.
MODEL_INPUT_VALIDATOR_RANGES_PATH=data/feature_ranges.json

# Strategy for handling NaN/Inf values: drop, impute_zero, impute_median, raise.
# Default: drop
# Optional.
MODEL_INPUT_VALIDATOR_NAN_STRATEGY=drop

# ---------------------------------------------------------------------------
# Feature selection
# ---------------------------------------------------------------------------

# Enable feature selection at inference time.
# Default: empty (disabled)
# Optional.
FEATURE_SELECTION_ENABLED=

# Path to selected_features.json produced by feature selection.
# Default: models/selected_features.json
# Optional.
FEATURE_SELECTION_PATH=models/selected_features.json

# ---------------------------------------------------------------------------
# Kafka advanced tuning
# ---------------------------------------------------------------------------

# High-water mark for Kafka consumer back-pressure.
# Default: 1000
# Optional.
KAFKA_BACKPRESSURE_HWM=1000

# Low-water mark for Kafka consumer back-pressure release.
# Default: 500
# Optional.
KAFKA_BACKPRESSURE_LWM=500

# Maximum retries for Kafka producer/consumer operations.
# Default: 5
# Optional.
KAFKA_MAX_RETRIES=5

# Dead-letter topic for Kafka consumer failures.
# Default: ledgerlens.trades.dlq
# Optional.
KAFKA_DEAD_LETTER_TOPIC=ledgerlens.trades.dlq

# Deduplication TTL (seconds) for Kafka consumer.
# Default: 3600
# Optional.
KAFKA_DEDUP_TTL_SECONDS=3600

# Producer transactional ID prefix.
# Default: ledgerlens-producer
# Optional.
KAFKA_TRANSACTIONAL_ID_PREFIX=ledgerlens-producer

# Producer transaction timeout (ms).
# Default: 60000
# Optional.
KAFKA_TRANSACTION_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# WebSocket abuse detection and heartbeat
# ---------------------------------------------------------------------------

# Maximum requests per minute per WebSocket client.
# Default: 300
# Optional.
WS_ABUSE_MAX_REQUESTS_PER_MINUTE=300

# Maximum distinct wallets per client per window.
# Default: 50
# Optional.
WS_ABUSE_MAX_DISTINCT_WALLETS=50

# Window (seconds) for distinct-wallet abuse detection.
# Default: 60
# Optional.
WS_ABUSE_WALLET_WINDOW_SECONDS=60

# Block duration (seconds) for abusive clients.
# Default: 300
# Optional.
WS_ABUSE_BLOCK_DURATION_SECONDS=300

# Seconds between WebSocket ping frames.
# Default: 30
# Optional.
WS_HEARTBEAT_INTERVAL_SECONDS=30

# ---------------------------------------------------------------------------
# Alert deduplication and watermarking
# ---------------------------------------------------------------------------

# Silence window (seconds) for correlated alert deduplication.
# Default: 60
# Optional.
ALERT_DEDUP_WINDOW_SECONDS=60

# Path to the JSON file that persists per-pair ingestion watermarks.
# Default: data/watermarks.json
# Optional.
WATERMARK_STORE_PATH=data/watermarks.json

# Flush watermark store to disk every N advance() calls.
# Default: 1
# Optional.
WATERMARK_FLUSH_EVERY_N=1

# ---------------------------------------------------------------------------
# Parallel processing controls
# ---------------------------------------------------------------------------

# Executor backend: "process" or "thread".
# Default: process
# Optional.
PARALLEL_EXECUTOR_BACKEND=process

# Maximum number of worker processes/threads.
# Default: CPU count - 1 (minimum 1)
# Optional.
PARALLEL_EXECUTOR_MAX_WORKERS=1

# Maximum number of in-flight futures (0 = unlimited).
# Default: 64
# Optional.
PARALLEL_EXECUTOR_MAX_PENDING=64

# Items per chunk for map_chunks().
# Default: 16
# Optional.
PARALLEL_EXECUTOR_CHUNK_SIZE=16

# Per-task timeout (seconds) for map() calls (0 = unlimited).
# Default: 300
# Optional.
PARALLEL_EXECUTOR_TIMEOUT_SECONDS=300

# ---------------------------------------------------------------------------
# Dataset storage abstraction
# ---------------------------------------------------------------------------

# Storage backend: "local" or "object".
# Default: local
# Optional.
DATASET_STORE_BACKEND=local

# Root directory (local) or bucket prefix (object).
# Default: ./data
# Optional.
DATASET_STORE_BASE_PATH=./data

# Default serialization format for generated datasets.
# Default: parquet
# Optional.
DATASET_STORE_FORMAT=parquet

# Object store URI for the "object" backend (e.g. s3://my-bucket/ledgerlens).
# Default: empty
# Optional.
DATASET_STORE_OBJECT_STORE_URL=

# ---------------------------------------------------------------------------
# Model watermarking
# ---------------------------------------------------------------------------

# Watermark key for IP theft detection.
# Default: empty
# Optional.
MODEL_WATERMARK_KEY=

# Trigger count for model watermark activation.
# Default: 10
# Optional.
MODEL_WATERMARK_TRIGGER_COUNT=10

# Path to watermark triggers JSON file.
# Default: data/watermark_triggers.json
# Optional.
MODEL_WATERMARK_TRIGGER_PATH=data/watermark_triggers.json

# ---------------------------------------------------------------------------
# Reporting, export, and risk propagation
# ---------------------------------------------------------------------------

# Report concurrency limit.
# Default: 4
# Optional.
REPORT_CONCURRENCY=4

# Narrative format for forensic reports: plain_text or markdown.
# Default: plain_text
# Optional.
REPORT_NARRATIVE_FORMAT=plain_text

# FATF export threshold (minimum risk score to include).
# Default: 0.85
# Optional.
FATF_EXPORT_THRESHOLD=0.85

# Weighted personalised PageRank convergence threshold.
# Default: 0.01
# Optional.
RISK_PROP_CONVERGENCE_THRESHOLD=0.01

# ---------------------------------------------------------------------------
# Trade deduplication
# ---------------------------------------------------------------------------

# TTL (seconds) for the trade deduplication cache.
# Default: 86400 (24 hours)
# Optional.
TRADE_DEDUP_TTL_SECONDS=86400

# Redis key prefix for the trade deduplication cache.
# Default: ledgerlens:trades:
# Optional.
TRADE_DEDUP_CACHE_KEY_PREFIX=ledgerlens:trades:

# ---------------------------------------------------------------------------
# Batch scoring
# ---------------------------------------------------------------------------

# Number of batch scorer worker processes.
# Default: 10
# Optional.
BATCH_SCORER_WORKERS=10

# ---------------------------------------------------------------------------
# Model calibration
# ---------------------------------------------------------------------------

# Calibration split fraction for holdout validation.
# Default: 0.20
# Optional.
CALIBRATION_SPLIT=0.20

# Random seed for calibration splits.
# Default: 42
# Optional.
CALIBRATION_RANDOM_SEED=42

# ---------------------------------------------------------------------------
# CUSUM change-point detection
# ---------------------------------------------------------------------------

# Target mean for CUSUM change-point detection.
# Default: 0.0
# Optional.
CUSUM_TARGET_MEAN=0.0

# Allowable slack for CUSUM detection.
# Default: 0.5
# Optional.
CUSUM_ALLOWABLE_SLACK=0.5

# Decision threshold for CUSUM alarms.
# Default: 5.0
# Optional.
CUSUM_DECISION_THRESHOLD=5.0

# ---------------------------------------------------------------------------
# End-to-end latency and anomaly detection
# ---------------------------------------------------------------------------

# E2E latency budget (milliseconds).
# Default: 2000
# Optional.
E2E_LATENCY_BUDGET_MS=2000

# Latency anomaly rate threshold.
# Default: 0.90
# Optional.
LATENCY_ANOMALY_RATE_THRESHOLD=0.90

# ---------------------------------------------------------------------------
# Bridge detector
# ---------------------------------------------------------------------------

# Roundtrip window (hours) for cross-chain bridge detection.
# Default: 72
# Optional.
BRIDGE_ROUNDTRIP_WINDOW_HOURS=72

# Minimum combined confidence for a cross-chain identity link to be used in
# risk propagation (see docs/cross_chain_identity.md).
# Default: 0.65
# Optional.
CROSS_CHAIN_MIN_CONFIDENCE=0.65

# ---------------------------------------------------------------------------
# Feature cache tuning (legacy)
# ---------------------------------------------------------------------------

# In-memory feature cache TTL (seconds).
# Default: 60
# Optional.
FEATURE_CACHE_TTL_SECONDS=60

# Maximum entries in the in-memory feature cache.
# Default: 10000
# Optional.
FEATURE_CACHE_MAXSIZE=10000

# ---------------------------------------------------------------------------
# Redis (general rate-limiter)
# ---------------------------------------------------------------------------

# Redis URL for the distributed rate limiter.
# Default: redis://localhost:6379/0
# Optional.
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# OpenTelemetry
# ---------------------------------------------------------------------------

# OTLP exporter endpoint for distributed tracing.
# Default: http://localhost:4317
# Optional.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Sampling rate for OpenTelemetry traces.
# Default: 0.1
# Optional.
OTEL_SAMPLING_RATE=0.1

# ---------------------------------------------------------------------------
# SHAP interaction and sensitivity
# ---------------------------------------------------------------------------

# Enable SHAP interaction values (expensive — O(n * d^2)).
# Default: false
# Optional.
SHAP_INTERACTIONS_ENABLED=false

# Path to per-feature SHAP sensitivity map.
# Default: models/shap_sensitivity.json
# Optional.
SHAP_SENSITIVITY_PATH=models/shap_sensitivity.json

# ---------------------------------------------------------------------------
# Drift detection windows
# ---------------------------------------------------------------------------

# Reference window size for drift detection.
# Default: 1000
# Optional.
DRIFT_WINDOW_SIZE=1000

# PSI threshold for triggering drift alerts.
# Default: 0.2
# Optional.
DRIFT_PSI_THRESHOLD=0.2

# Reference window (hours) for MMD covariance shift detection.
# Default: 168
# Optional.
DRIFT_REFERENCE_WINDOW_HOURS=168

# Test window (hours) for MMD covariance shift detection.
# Default: 1
# Optional.
DRIFT_TEST_WINDOW_HOURS=1

# Interval (minutes) between drift checks.
# Default: 30
# Optional.
DRIFT_CHECK_INTERVAL_MINUTES=30

# ---------------------------------------------------------------------------
# REST API auth / rate limiting
# ---------------------------------------------------------------------------

# Comma-separated list of bcrypt-hashed API keys.
# Default: empty
# Optional.
API_KEYS=

# Per-key rate limit (requests per minute).
# Default: 60
# Optional.
API_RATE_LIMIT_RPM=60

# ---------------------------------------------------------------------------
# Threshold RL agent
# ---------------------------------------------------------------------------

# Pin the alert threshold and disable the RL agent (set to non-zero to enable).
# Default: 0
# Optional.
THRESHOLD_RL_PINNED=0

# ---------------------------------------------------------------------------
# DP-SGD training
# ---------------------------------------------------------------------------

# Target privacy budget (epsilon) for DP-SGD training.
# Default: 8.0
# Optional.
DP_TARGET_EPSILON=8.0

# Target privacy budget (delta) for DP-SGD training.
# Default: 1e-5
# Optional.
DP_TARGET_DELTA=1e-5

# Rényi query threshold before scaling noise.
# Default: 100
# Optional.
# Differential privacy for SHAP explanations (model inversion defence)
# Default: 1.0
# Optional.
DP_EPSILON=1.0
# Default: 1e-5
# Optional.
DP_DELTA=1e-5
DP_RENYI_QUERY_THRESHOLD=100

# Noise multiplier applied past the Rényi threshold.
# Default: 3.0
# Optional.
DP_RENYI_NOISE_MULTIPLIER=3.0

# ---------------------------------------------------------------------------
# Kafka topic naming
# ---------------------------------------------------------------------------

# Kafka topic prefix for trade events.
# Default: ledgerlens.trades
# Optional.
KAFKA_TOPIC_PREFIX=ledgerlens.trades

# Kafka dead-letter queue topic.
# Default: ledgerlens.trades.dlq
# Optional.
KAFKA_DLQ_TOPIC=ledgerlens.trades.dlq

# Regex subscription pattern for per-pair topics.
# Default: ^ledgerlens\.trades\..*
# Optional.
KAFKA_TOPIC_PATTERN=^ledgerlens\.trades\..*

# ---------------------------------------------------------------------------
# Account metadata streaming join
# ---------------------------------------------------------------------------

# Kafka topic for account metadata update events.
# Default: ledgerlens.account_metadata
# Optional.
METADATA_TOPIC=ledgerlens.account_metadata

# How long (seconds) a metadata update enriches incoming trade events.
# Default: 3600
# Optional.
METADATA_JOIN_WINDOW_SECONDS=3600

# TTL (seconds) for active wallets in the metadata join state.
# Default: 86400
# Optional.
METADATA_ACTIVE_WALLET_TTL_SECONDS=86400

# ---------------------------------------------------------------------------
# Trade ingestion schema
# ---------------------------------------------------------------------------

# Path to the Avro schema for trade events.
# Default: data/trade_avro_schema.json
# Optional.
TRADE_AVRO_SCHEMA_PATH=data/trade_avro_schema.json

