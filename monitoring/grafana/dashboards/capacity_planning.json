{
  "annotations": {"list": []},
  "editable": true,
  "schemaVersion": 39,
  "title": "LedgerLens — Capacity Planning",
  "tags": ["ledgerlens", "capacity", "infrastructure"],
  "timezone": "browser",
  "time": {"from": "now-7d", "to": "now"},
  "refresh": "5m",
  "panels": [
    {
      "id": 1,
      "title": "CPU Usage by Component",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.6},
              {"color": "red", "value": 0.8}
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "ledgerlens_cpu_usage_ratio",
          "legendFormat": "{{component}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Memory Usage",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "expr": "ledgerlens_memory_usage_bytes",
          "legendFormat": "RSS"
        }
      ]
    },
    {
      "id": 3,
      "title": "Trade Ingestion Rate by Asset Pair",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "targets": [
        {
          "expr": "ledgerlens_trades_per_second",
          "legendFormat": "{{asset_pair}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "CPU Trend Projection (7-day linear regression)",
      "description": "Solid line = predicted CPU usage. Shaded band = ±1.96σ confidence interval. Red line = 80% capacity threshold. Requires at least 7 days of historical data before the forecast is meaningful.",
      "type": "timeseries",
      "gridPos": {"h": 10, "w": 12, "x": 12, "y": 8},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "targets": [
        {
          "expr": "avg(ledgerlens_cpu_usage_ratio)",
          "legendFormat": "Current (avg)"
        },
        {
          "expr": "predict_linear(ledgerlens_cpu_usage_ratio[7d], 86400 * 30)",
          "legendFormat": "Projected (30d)"
        },
        {
          "expr": "predict_linear(ledgerlens_cpu_usage_ratio[7d], 86400 * 30) + 1.96 * stddev_over_time(ledgerlens_cpu_usage_ratio[7d])",
          "legendFormat": "CI upper (95%)",
          "custom": {"fillOpacity": 10, "lineWidth": 0}
        },
        {
          "expr": "predict_linear(ledgerlens_cpu_usage_ratio[7d], 86400 * 30) - 1.96 * stddev_over_time(ledgerlens_cpu_usage_ratio[7d])",
          "legendFormat": "CI lower (95%)",
          "custom": {"fillOpacity": 10, "lineWidth": 0}
        },
        {
          "expr": "vector(0.8)",
          "legendFormat": "80% threshold"
        }
      ]
    },
    {
      "id": 5,
      "title": "Days to 80% CPU Capacity",
      "description": "Estimated days until average CPU usage reaches 80% at current growth rate (from recording rule). Shows N/A when CPU is declining or already above 80%.",
      "type": "stat",
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 16},
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 14},
              {"color": "green", "value": 30}
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "graphMode": "none",
        "colorMode": "background"
      },
      "targets": [
        {
          "expr": "ledgerlens:capacity_days_to_80pct_cpu",
          "legendFormat": "Days to 80% CPU"
        }
      ]
    },
    {
      "id": 6,
      "title": "Memory Growth Rate",
      "description": "Per-second rate of memory growth projected over 7 days.",
      "type": "stat",
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 16},
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "deriv(ledgerlens_memory_usage_bytes[7d])",
          "legendFormat": "Memory growth (bytes/s)"
        }
      ]
    },
    {
      "id": 7,
      "title": "Python Forecast — CPU Trend Line with Confidence Interval",
      "description": "Trend line and 95% CI computed by the Python CapacityForecaster (OLS linear + weekly seasonal decomposition). Published via ledgerlens_forecast_cpu_ratio. The 1-day and 7-day horizon points show where the forecast model expects utilisation to be. Use this alongside the Prometheus predict_linear panel (panel 4) to cross-validate projections. Data only appears after the Python forecaster has accumulated sufficient history (default: 14 observations).",
      "type": "timeseries",
      "gridPos": {"h": 10, "w": 12, "x": 0, "y": 21},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Capacity limit (90%)"},
            "properties": [
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}},
              {"id": "custom.lineWidth", "value": 2},
              {"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [8, 4]}}
            ]
          },
          {
            "matcher": {"id": "byRegexp", "options": ".*CI.*"},
            "properties": [
              {"id": "custom.fillOpacity", "value": 10},
              {"id": "custom.lineWidth", "value": 0}
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "avg(ledgerlens_cpu_usage_ratio)",
          "legendFormat": "Current utilisation"
        },
        {
          "expr": "ledgerlens_forecast_cpu_ratio{horizon_days=\"1\"}",
          "legendFormat": "Forecast +1 day ({{component}})"
        },
        {
          "expr": "ledgerlens_forecast_cpu_ratio{horizon_days=\"7\"}",
          "legendFormat": "Forecast +7 days ({{component}})"
        },
        {
          "expr": "vector(0.9)",
          "legendFormat": "Capacity limit (90%)"
        }
      ]
    },
    {
      "id": 8,
      "title": "Python Forecast — Days to Capacity Limit",
      "description": "Days until each metric is projected to reach its configured capacity threshold, as computed by the Python CapacityForecaster. A value of -1 means no crossing is projected (trend is flat or declining). Thresholds: red < 5 days (alert fires), yellow < 14 days (warning), green ≥ 14 days.",
      "type": "stat",
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 21},
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "noValue": "No breach projected",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "orange", "value": 0},
              {"color": "yellow", "value": 5},
              {"color": "green", "value": 14}
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "graphMode": "none",
        "colorMode": "background"
      },
      "targets": [
        {
          "expr": "ledgerlens_forecast_days_to_capacity_limit",
          "legendFormat": "Days to limit — {{metric}}"
        }
      ]
    }
  ]
}
